# 二采放大权重（690MB，超 GitHub 单文件 100MB 限制，请从 HuggingFace 下载：
# https://huggingface.co/LBH-123-AI/Minimax_h3_latent_Upscaler ）
放大模型放到latent_upscale_models/

# 项目工作数据（AI 助手本地记忆，不属于插件本体）
.workbuddy/
.workbuddy-ai/

# 本地私有默认值：内含 API Key / 默认服务商，**绝不入库**
optimizer.local.json
optimizer.local.json.bak-*

# 前端测试依赖（jsdom 等，npm install 生成；package.json/lock 已入库）
node_modules/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 编辑器/手工备份（不留双轨）
*.bak-*
*.orig

# 系统杂物
Thumbs.db
.DS_Store

# 生成物：由 tools/make_anchor_preview.py 从 web/ 现读现拼，不入库（必然漂移）
tools/anchor_preview.html

# 性能探测日志（运行时生成，回读用 tools/perf_report.py）
logs/
